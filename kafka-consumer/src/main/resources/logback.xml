<?xml version="1.0" encoding="UTF-8"?>
<!-- Kafka Consumer Logback Configuration -->
<configuration debug="false">
    
    <!-- Property definitions -->
    <property name="APP_NAME" value="kafka-consumer"/>
    <property name="LOG_FILE" value="logs/kafka-consumer"/>
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>
    
    <!-- Console appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    
    <!-- File appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_FILE}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>
    
    <!-- Application loggers -->
    <logger name="com.example" level="INFO" appender-ref="CONSOLE"/>
    <logger name="com.example.kafkaconsumer" level="INFO" appender-ref="CONSOLE"/>
    
    <!-- Kafka client logging -->
    <logger name="org.apache.kafka" level="WARN" appender-ref="CONSOLE"/>
    <logger name="org.apache.kafka.clients" level="INFO" appender-ref="CONSOLE"/>
    
    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
    
    <!-- Scenario-specific logging -->
    
    <!-- Order Creation [semantic-anchor: scenario.order-creation] -->
    <logger name="com.example.kafkaconsumer.OrderEventConsumer.processOrderCreated" 
            level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>
    
    <!-- Payment Processing [semantic-anchor: scenario.payment-processing] -->
    <logger name="com.example.kafkaconsumer.OrderEventConsumer.processPaymentReceived" 
            level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>
    
    <logger name="com.example.kafkaconsumer.OrderEventConsumer.processPaymentFailed" 
            level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>
    
    <!-- Order Cancellation [semantic-anchor: scenario.order-cancellation] -->
    <logger name="com.example.kafkaconsumer.OrderEventConsumer.processOrderCancelled" 
            level="WARN" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>
    
    <!-- Shipment Start [semantic-anchor: scenario.shipment-start] -->
    <logger name="com.example.kafkaconsumer.OrderEventConsumer.processShipmentStarted" 
            level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>
</configuration>